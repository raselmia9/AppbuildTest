<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Video Player View (30% Height approx) -->
        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="#000000" />

        <!-- Input Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/etVideoUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Video URL (MP4, MKV, M3U8, MPD)"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:text="https://pixeldrain.dev/api/file/1KH8eZeo?download"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etCookie"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Cookie (Optional)"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etReferer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Referer (Optional)"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etUserAgent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="User-Agent (Optional)"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etAuthorization"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Authorization (Optional)"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:textSize="14sp" />

            <!-- Play Button -->
            <Button
                android:id="@+id/btnPlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="#6200EE"
                android:text="PLAY VIDEO"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
